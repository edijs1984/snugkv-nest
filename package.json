{
  "name": "snugkv-nest",
  "version": "0.4.0",
  "description": "NestJS module and TypeScript client for SnugKV: data types, cache, locks, rate limits, pub/sub, transactions, job queues, flow tracing and a durable stream message bus.",
  "keywords": [
    "nestjs",
    "snugkv",
    "redis",
    "client",
    "cache",
    "lock",
    "rate-limit",
    "pubsub",
    "streams",
    "message-bus",
    "microservices",
    "consumer-group",
    "queue",
    "job-queue",
    "bullmq"
  ],
  "license": "MIT",
  "author": "Edijs Ziedins",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edijs1984/snugkv-nest.git"
  },
  "homepage": "https://github.com/edijs1984/snugkv-nest#readme",
  "bugs": {
    "url": "https://github.com/edijs1984/snugkv-nest/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "core": [
        "dist/core/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "rm -rf dist-test && tsc -p tsconfig.test.json && node --test --test-concurrency=1 dist-test/test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.1.0"
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/node": "^22.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typescript": "^5.6.0"
  }
}
